{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "r2_buckets": [
    {
      "binding": "my_media",
      "bucket_name": "portfolio-tik-view-nof"
    }
  ]
}
